[Unit]
Description=OptionSmith Option Strategy Advisor (port 8030)
After=network-online.target gw-central.service
Wants=network-online.target
# Wants, not Requires: the advisor is useful on a file or synthetic chain even
# with the gateway down, and taking it offline alongside the gateway would hide
# the "broker session down" message that tells the user what to fix.
Wants=gw-central.service

[Service]
Type=simple
WorkingDirectory=/opt/optionsmith
EnvironmentFile=/opt/optionsmith/.env
ExecStart=/opt/optionsmith/.venv/bin/python -m optionsmith ui --host 0.0.0.0 --port 8030
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

# OptionSmith — live data via the trading Gateway.
#
# OptionSmith holds NO broker credentials. It authenticates to the Gateway as a
# service and receives a short-lived scoped JWT; the broker login and its
# secrets stay inside the Gateway.
#
# Issue the credentials below from the Gateway host:
#
#   cd /opt/gateway_system/Gateway/gateway_backend
#   ./venv/bin/python -m scripts.register_service --name optionsmith --scopes market
#
# `market` is the only scope it needs — the advisor reads quotes and chains and
# places no orders. Granting more would widen the blast radius of a leaked
# secret for no functionality.

GATEWAY_BASE_URL=http://127.0.0.1:8000
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET=

# A cold chain build is one broker round-trip per leg, so it is tens of seconds
# on a wide window. Raise this before lowering --strikes.
GATEWAY_TIMEOUT=90

# Set to 0 only for a gateway behind a self-signed certificate.
GATEWAY_VERIFY_TLS=1

# Dashboard bind. 127.0.0.1 keeps it local; the systemd unit sets 0.0.0.0.
OPTIONSMITH_HOST=127.0.0.1
OPTIONSMITH_PORT=8030
